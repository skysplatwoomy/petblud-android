<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PetBlud" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/pet_lime</item>
        <item name="colorOnPrimary">@color/pet_bg</item>
        <item name="colorSecondary">@color/pet_coral</item>
        <item name="colorOnSecondary">@color/pet_bg</item>
        <item name="colorSurface">@color/pet_surface</item>
        <item name="colorOnSurface">@color/pet_cream</item>
        <item name="colorOutline">@color/pet_outline</item>
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="android:windowBackground">@color/pet_bg</item>
        <item name="android:navigationBarColor">@color/pet_bg</item>
        <item name="android:statusBarColor">@color/pet_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.PetBlud.Hoots" parent="Theme.PetBlud">
        <item name="colorPrimary">@color/hoots_orange</item>
        <item name="colorSecondary">@color/hoots_orange_soft</item>
    </style>

    <style name="TextAppearance.PetBlud.Wordmark" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pet_cream</item>
    </style>

    <style name="TextAppearance.PetBlud.Section" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pet_cream</item>
    </style>

    <style name="TextAppearance.PetBlud.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/pet_cream</item>
    </style>

    <style name="TextAppearance.PetBlud.Support" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/pet_text_secondary</item>
    </style>

    <style name="Widget.PetBlud.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/pet_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/pet_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.PetBlud.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PetBlud.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PetBlud.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/pet_coral</item>
        <item name="android:textColor">@color/pet_coral</item>
        <item name="iconTint">@color/pet_coral</item>
    </style>
</resources>
