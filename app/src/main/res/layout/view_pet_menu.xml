<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PetBlud.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/pet_surface_high"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/menuTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.PetBlud.Section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuClose"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/close_seedy_menu"
                    app:icon="@drawable/ic_close" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick_actions"
                android:textAppearance="@style/TextAppearance.PetBlud.Support" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuSpawn"
                    style="@style/Widget.PetBlud.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/spawn" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuExplode"
                    style="@style/Widget.PetBlud.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:text="@string/blast" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menuDetonate"
                    style="@style/Widget.PetBlud.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/chaos" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/menuGravity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/gravity_for_seedy" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/menuChatGptBubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/show_hoots_chatgpt_bubble"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/physics"
                    android:textAppearance="@style/TextAppearance.PetBlud.Body" />

                <TextView
                    android:id="@+id/menuPhysicsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:textAppearance="@style/TextAppearance.PetBlud.Support" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/menuPhysics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/physics_for_seedy"
                android:valueFrom="0.1"
                android:valueTo="5.0"
                android:stepSize="0.1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuSettings"
                style="@style/Widget.PetBlud.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/open_petblud_settings"
                app:icon="@drawable/ic_settings" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/pet_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/danger_zone"
                android:textColor="@color/pet_coral"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuRemoveThis"
                style="@style/Widget.PetBlud.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/remove_this_seedy"
                app:icon="@drawable/ic_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuRemoveOthers"
                style="@style/Widget.PetBlud.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/remove_other_seedys" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuRemoveAll"
                style="@style/Widget.PetBlud.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/remove_all_seedys" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
