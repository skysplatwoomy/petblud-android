<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroCard"
            style="@style/Widget.PetBlud.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/heroPet"
                    android:layout_width="82dp"
                    android:layout_height="89dp"
                    android:contentDescription="@string/seedy"
                    android:filter="false"
                    android:scaleType="fitCenter"
                    android:src="@drawable/seedy_idle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.PetBlud.Section"
                        app:drawableStartCompat="@drawable/status_dot" />

                    <TextView
                        android:id="@+id/heroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.PetBlud.Support" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/heroAction"
                        style="@style/Widget.PetBlud.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/quick_actions"
            android:textAppearance="@style/TextAppearance.PetBlud.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/spawnButton"
                    style="@style/Widget.PetBlud.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/spawn_one_seedy"
                    android:text="@string/add_seedy"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detonateButton"
                    style="@style/Widget.PetBlud.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/detonate_all_seedys"
                    android:text="@string/detonate"
                    app:icon="@drawable/ic_bomb"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permissionsButton"
                style="@style/Widget.PetBlud.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/open_overlay_permissions"
                android:text="@string/access"
                app:icon="@drawable/ic_shield"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PetBlud.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/motion_and_gravity"
                    android:textAppearance="@style/TextAppearance.PetBlud.Section" />

                <TextView
                    android:id="@+id/motionSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/motion_support"
                    android:textAppearance="@style/TextAppearance.PetBlud.Support" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/gravitySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/gravity" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/tiltGravitySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/tilt_controls_gravity" />

                <LinearLayout
                    android:id="@+id/motionChildren"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/shakeSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:text="@string/shake_to_blast" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/uprightSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:text="@string/keep_seedy_upright" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PetBlud.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/world"
                    android:textAppearance="@style/TextAppearance.PetBlud.Section" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/keyboardSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/stay_above_keyboard" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/collisionSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/seedy_collisions" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/crossCollisionSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/seedy_hoots_collisions"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PetBlud.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feel"
                    android:textAppearance="@style/TextAppearance.PetBlud.Section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/physics"
                        android:textAppearance="@style/TextAppearance.PetBlud.Body" />

                    <TextView
                        android:id="@+id/physicsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PetBlud.Support" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/physicsSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/physics_multiplier"
                    android:valueFrom="0.1"
                    android:valueTo="5.0"
                    android:stepSize="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sizeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/seedy_size"
                        android:textAppearance="@style/TextAppearance.PetBlud.Body" />

                    <TextView
                        android:id="@+id/sizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PetBlud.Support" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/seedy_size_percentage"
                    android:valueFrom="10"
                    android:valueTo="500"
                    android:stepSize="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/autoSaveSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/auto_save_support"
            android:textAppearance="@style/TextAppearance.PetBlud.Support" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
